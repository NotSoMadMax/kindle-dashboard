[Unit]
Description=nginx for the Kindle dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Workspace/kindle-dashboard
Environment=PROJECT=%h/Workspace/kindle-dashboard
Environment=KINDLE_DASHBOARD_RUNTIME_ROOT=/dev/shm/kindle-dashboard
ExecStartPre=%h/Workspace/kindle-dashboard/scripts/prepare-runtime.sh
ExecStart=/usr/bin/sg docker -c %h/Workspace/kindle-dashboard/scripts/run-nginx.sh
ExecStop=-/usr/bin/sg docker -c %h/Workspace/kindle-dashboard/scripts/stop-nginx.sh
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=20

[Install]
WantedBy=default.target
